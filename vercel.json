{
  "rewrites": [
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/scan-events",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/update-metrics",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/ad-engine-metrics",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/ad-engine-optimize",
      "schedule": "30 */6 * * *"
    }
  ]
}
